# Database
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (for initial setup)
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="your-password-here"

# Object Storage (S3-compatible: AWS S3, Supabase Storage, Cloudflare R2, etc.)
# REQUIRED for media uploads in production
S3_ENDPOINT="https://your-endpoint.supabase.co/storage/v1/s3"  # or AWS endpoint
S3_REGION="auto"  # AWS region or "auto" for Cloudflare R2
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_PUBLIC_URL="https://your-bucket-public-url.com"  # Optional: custom public URL for assets
